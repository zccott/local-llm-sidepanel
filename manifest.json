{
  "manifest_version": 3,
  "name": "LocalMind - Local LLM Side Panel",
  "version": "1.0.0",
  "description": "Chat with Ollama models on your computer or local network from Chrome's side panel. Private: nothing goes to the cloud.",
  "homepage_url": "https://github.com/zccott/local-llm-sidepanel",
  "permissions": [
    "sidePanel",
    "storage",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Open LocalMind Side Panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
